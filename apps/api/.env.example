PORT=3001

# Postgres (Drizzle)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_recruiter

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Mailjet (password reset email). If unset, dev logs the reset link instead.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=AI Recruiter

# --- Object storage (Cloudflare R2) ---
# Bucket per environment: hirepilotx-dev / hirepilotx-staging / hirepilotx-assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hirepilotx-dev
# Custom domain for PUBLIC assets only (logos, avatars). Private files are signed.
R2_PUBLIC_BASE_URL=https://assets.hirepilotx.com
