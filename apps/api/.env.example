PORT=3001

# Postgres (Drizzle)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_recruiter

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Mailjet (password reset email). If unset, dev logs the reset link instead.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=AI Recruiter
