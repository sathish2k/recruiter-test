{"nodes": [{"id": "renderers_skill_genericrenderer", "label": "GenericRenderer (value/cell dispatcher)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One value vocabulary (entity, pill, status, ai-match, score-bar, date, \u2026) shared by tables, cards, lists and stat cards; a repeated look becomes a new type here, never bespoke markup in a feature."}, {"id": "renderers_skill_iconrenderer", "label": "IconRenderer + ICON_REGISTRY", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ONLY icon source \u2014 features never import @mui/icons-material. Must forward className or MUI slot APIs (Chip icon, ListItemIcon) silently lose their styling hook."}, {"id": "renderers_skill_linkrenderer", "label": "LinkRenderer (the only navigation primitive)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves route ids to SPA links; can wrap any component as children. queryParams can carry serialized filters/sort so a link pre-filters the target screen."}, {"id": "renderers_skill_tabnavrenderer", "label": "TabNavRenderer (shared area tab bar)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_listsection", "label": "ListSection (card-of-rows primitive)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_listrenderer", "label": "ListRenderer (config-driven list)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_cardrenderer", "label": "CardRenderer (one renderer for every feature card)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A new card is a config, not a file. Never nest a link inside a linked card \u2014 <a> in <a> throws a hydration error; the footer auto-drops action links when a top-level link is set."}, {"id": "renderers_skill_statcardrenderer", "label": "StatCardRenderer", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grid columns come from each card's span in config, never a prop \u2014 there is deliberately no gridTemplateColumns prop."}, {"id": "renderers_skill_messagealertrenderer", "label": "MessageAlertRenderer (inline insight/warning strips)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "showPath gates the strip on a data path being non-zero so a data-driven alert disappears when its condition clears \u2014 always set it."}, {"id": "renderers_skill_funnelrenderer", "label": "FunnelRenderer (gradient stage bars)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_barchartrenderer", "label": "BarChartRenderer (CSS design-match chart)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built as CSS/flex, not chart-library output, because the design's chrome (peak badge, conversion pills, inset highlight) is beyond what ApexCharts can draw."}, {"id": "renderers_skill_stagefunnelrenderer", "label": "StageFunnelRenderer (pipeline health board)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Insight note reads from the fetch's meta ({ bottleneckStage, bottleneckCount }) so the whole card is one request."}, {"id": "renderers_skill_graphrenderer", "label": "GraphRenderer (ApexCharts config-driven graphs)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "categoryLabelPrefix keeps axis labels in translations (API returns keys); categoryType datetime means the API returns raw YYYY-MM-DD, never display text."}, {"id": "renderers_skill_chart", "label": "Chart (imperative apexcharts driver)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_slidingpilltabs", "label": "SlidingPillTabs (sliding gradient pill)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app's one pill tab bar \u2014 an absolutely-positioned pill measured against the active tab so switching slides instead of swapping backgrounds; every new segmented control goes through it."}, {"id": "renderers_skill_segmentedfilterrenderer", "label": "SegmentedFilterRenderer (toggle \u2192 search param)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_useformatters", "label": "useFormatters (locale-aware formatting)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "renderers_skill_uselocale", "label": "useLocale preference store (server-seeded)", "file_type": "concept", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeded server-side on boot (getBootLocale fetches effective prefs) so first paint is correct on any device; localStorage is only the fallback when the server gave nothing."}, {"id": "renderers_skill_skeleton_rule", "label": "Every data-driven renderer owns a skeleton", "file_type": "rationale", "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each renderer renders a placeholder from useFetch isLoading that mirrors its real geometry so nothing resizes when data lands."}], "edges": [{"source": "renderers_skill_genericrenderer", "target": "renderers_skill_iconrenderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "renderers_skill_genericrenderer", "target": "renderers_skill_linkrenderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/renderers/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "renderers_skill_genericrenderer", "target": "renderers_skill_useformatters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":