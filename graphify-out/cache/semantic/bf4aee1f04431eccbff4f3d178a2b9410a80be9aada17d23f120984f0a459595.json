{"nodes": [{"id": "form_renderer_skill_formrenderer", "label": "FormRenderer (ajv + react-hook-form)", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "form_renderer_skill_formwithsectionsrenderer", "label": "FormWithSectionsRenderer (sectioned page forms)", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One form (single useForm + ajv) rendered as titled Card sections; preferred over hand-placed Fields for any multi-card settings/profile screen. Two-column layouts are section groups with grid sizes \u2014 pure config, no hardcoded columns."}, {"id": "form_renderer_skill_formmodal", "label": "FormModal + useModal add/edit flow", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "form_renderer_skill_widget_system", "label": "Form widget system (schema-driven widgets + inference)", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widget resolution: explicit widget key, else inferred from schema shape (array+enum \u2192 checkbox-group, enum \u2192 select, boolean \u2192 switch, format password/date, else text). All text values are translation keys."}, {"id": "form_renderer_skill_custom_widgets", "label": "Custom widgets escape hatch (widgets prop)", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The widget name IS the key, resolved from the widgets prop before built-ins. Called as a plain function, not mounted as a component \u2014 so an inline arrow is safe (component identity would remount and drop focus), but it shares the enclosing hook order so keys must not swap conditionally."}, {"id": "form_renderer_skill_fieldshell", "label": "FieldShell (label + error chrome)", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "form_renderer_skill_validation_flow", "label": "Validation & normalization split", "file_type": "concept", "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The resolver strips empty strings before ajv so required fails on blanks and optional blanks skip format checks. Cross-field rules ajv can't express go in onSubmit; authoritative normalization (trim, E.164, URL canonicalization) belongs in the backend service."}], "edges": [{"source": "form_renderer_skill_formrenderer", "target": "form_renderer_skill_widget_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "form_renderer_skill_widget_system", "target": "form_renderer_skill_fieldshell", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "form_renderer_skill_widget_system", "target": "renderers_skill_iconrenderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/form-renderer/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "form_renderer_skill_formwithsectionsrenderer", "target": "form_renderer_skill_formrenderer", "relation": "referenc