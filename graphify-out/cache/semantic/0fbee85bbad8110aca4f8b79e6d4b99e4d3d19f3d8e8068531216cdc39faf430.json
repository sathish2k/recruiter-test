{"nodes": [{"id": "architecture_skill_five_file_pattern", "label": "Feature component 5-file pattern", "file_type": "concept", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "component/configuration/translations/datasource/bootstrap split keeps structure, text, and data access declarative and separately swappable; the .component.tsx is skipped entirely when it would only forward to a shared renderer."}, {"id": "architecture_skill_direct_renderer_binding", "label": "Binding shared renderers directly as ComponentDefinition.value", "file_type": "rationale", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine injects id/configuration/data/translation, and renderers read their slice by id \u2014 so a table/stat/funnel screen needs no wrapper component, just config + datasource."}, {"id": "architecture_skill_injected_id_semantics", "label": "Injected id = component id, not element id", "file_type": "concept", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine keys configurationMap/dataMap/translationMap by element.componentType because those all come from the ComponentDefinition; naming the element id in a translating config silently falls back to raw keys."}, {"id": "architecture_skill_data_prop_footgun", "label": "data={} footgun (seedRows / seedRecord)", "file_type": "rationale", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine injects data={} when there is no prefetch and useFetch skips fetching for any non-undefined data, so renderers must normalise via seedRows/seedRecord from @recruit/shared or they silently render empty \u2014 how GraphRenderer shipped blank."}, {"id": "architecture_skill_composition_rules", "label": "Composition rules (atoms \u2192 shared \u2192 features)", "file_type": "concept", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Themed MUI atoms build shared components; shared renderers build feature modules driven by *.configuration.ts; rendering logic is never reimplemented in a module."}, {"id": "architecture_skill_access_control", "label": "Access control (access rules on config objects)", "file_type": "concept", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI filtering is cosmetic \u2014 denied routes redirect, denied elements/config parts are silently stripped; the API enforces for real."}, {"id": "architecture_skill_detail_routes", "label": "Detail routes (:id params + useRouteParams)", "file_type": "concept", "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "architecture_skill_five_file_pattern", "target": "claude_md_config_driven_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "architecture_skill_direct_renderer_binding", "target": "architecture_skill_five_file_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/architecture/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "architecture_skill_direct_renderer_binding", "target": "table_renderer_skill_tablerenderer", "relation": "references",