{"nodes": [{"id": "table_renderer_skill_tablerenderer", "label": "TableRenderer (config-driven tables)", "file_type": "concept", "source_file": ".claude/skills/table-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every table goes through TableRenderer; a feature component is one line and all chrome comes from the theme, never inline restyling."}, {"id": "table_renderer_skill_tablefilterexportrenderer", "label": "TableFilterExportRenderer (toolbar variant)", "file_type": "concept", "source_file": ".claude/skills/table-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_renderer_skill_custom_cells", "label": "Custom table cells (cells prop escape hatch)", "file_type": "concept", "source_file": ".claude/skills/table-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cell type IS the key: unknown types resolve from the cells prop in TableCellRenderer before falling through to GenericRenderer, which knows nothing about it. Repeated looks get promoted to real GenericRenderer types."}, {"id": "table_renderer_skill_server_mode", "label": "Server-mode pagination/sort/filter query contract", "file_type": "concept", "source_file": ".claude/skills/table-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Query = { ...filters, sortKey, sortDir, page, pageSize }; the API must return { data, meta: { totalCount } } and honor the params server-side."}, {"id": "table_renderer_skill_usesort", "label": "useSort (URL-synced sort state)", "file_type": "concept", "source_file": ".claude/skills/table-renderer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "table_renderer_