{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@recruit/types": ["./packages/types/src/index.ts"],
      "@recruit/sdk": ["./packages/recruit-sdk/src/index.ts"],
      "@recruit/shared": ["./packages/shared/src/index.ts"],
      "@recruit/ui": ["./packages/ui/src/index.ts"],
      "@recruit/configurations": [
        "./packages/configurations/src/index.ts"
      ],
      "@recruit/module-auth": ["./packages/modules/recruit-auth/src/index.ts"],
      "@recruit/module-core": ["./packages/modules/recruit-core/src/index.ts"],
      "@recruit/module-dashboard": [
        "./packages/modules/recruit-dashboard/src/index.ts"
      ],
      "@recruit/module-jobs": ["./packages/modules/recruit-jobs/src/index.ts"],
      "@recruit/module-candidate": [
        "./packages/modules/recruit-candidate/src/index.ts"
      ],
      "@recruit/module-client": [
        "./packages/modules/recruit-client/src/index.ts"
      ],
      "@recruit/module-settings": [
        "./packages/modules/recruit-settings/src/index.ts"
      ],
      "@recruit/module-pipeline": [
        "./packages/modules/recruit-pipeline/src/index.ts"
      ],
      "@recruit/module-ai": ["./packages/modules/recruit-ai/src/index.ts"]
    }
  }
}
