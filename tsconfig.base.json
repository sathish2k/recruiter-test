{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "paths": {
      "@recruit/sdk": ["./packages/recruit-sdk/src/index.ts"],
      "@recruit/types": ["./packages/types/src/index.ts"],
      "@recruit/ui": ["./packages/ui/src/index.ts"],
      "@recruit/shared": ["./packages/shared/src/index.ts"],
      "@recruit/module-auth": ["./packages/modules/recruit-auth/src/index.ts"],
      "@recruit/module-core": ["./packages/modules/recruit-core/src/index.ts"],
      "@recruit/module-dashboard": ["./packages/modules/recruit-dashboard/src/index.ts"],
      "@recruit/role-owner": ["./packages/modules/recruit-roles/recruit-owner/src/index.ts"],
      "@recruit/role-admin": ["./packages/modules/recruit-roles/recruit-admin/src/index.ts"],
      "@recruit/role-account-manager": ["./packages/modules/recruit-roles/recruit-account-manager/src/index.ts"],
      "@recruit/role-team-lead": ["./packages/modules/recruit-roles/recruit-team-lead/src/index.ts"],
      "@recruit/role-recruiter": ["./packages/modules/recruit-roles/recruit-recruiter/src/index.ts"],
      "@recruit/role-sourcer": ["./packages/modules/recruit-roles/recruit-sourcer/src/index.ts"],
      "@recruit/role-hiring-manager": ["./packages/modules/recruit-roles/recruit-hiring-manager/src/index.ts"],
      "@recruit/role-client": ["./packages/modules/recruit-roles/recruit-client/src/index.ts"],
      "@recruit/roles": ["./packages/modules/recruit-roles/src/index.ts"],
      "@recruit/module-settings": ["./packages/modules/recruit-settings/src/index.ts"],
      "@recruit/module-profile": ["./packages/modules/recruit-profile/src/index.ts"],
      "@recruit/module-contact": ["./packages/modules/recruit-contact/src/index.ts"],
      "@recruit/module-client": ["./packages/modules/recruit-client/src/index.ts"],
      "@recruit/module-jobs": ["./packages/modules/recruit-jobs/src/index.ts"],
      "@recruit/module-candidate": ["./packages/modules/recruit-candidate/src/index.ts"],
      "@recruit/module-pipeline": ["./packages/modules/recruit-pipeline/src/index.ts"],
      "@recruit/module-onboarding": ["./packages/modules/recruit-onboarding/src/index.ts"],
      "@recruit/configurations": ["./packages/configurations/src/index.ts"]
    }
  }
}
