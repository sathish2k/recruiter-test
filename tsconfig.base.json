{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "paths": {
      "@recruit/sdk": ["./packages/recruit-sdk/src/index.ts"],
      "@recruit/types": ["./packages/types/src/index.ts"],
      "@recruit/ui": ["./packages/ui/src/index.ts"],
      "@recruit/shared": ["./packages/shared/src/index.ts"],
      "@recruit/module-auth": ["./packages/modules/recruit-auth/src/index.ts"],
      "@recruit/module-core": ["./packages/modules/recruit-core/src/index.ts"],
      "@recruit/module-dashboard": ["./packages/modules/recruit-dashboard/src/index.ts"],
      "@recruit/module-settings": ["./packages/modules/recruit-settings/src/index.ts"],
      "@recruit/module-profile": ["./packages/modules/recruit-profile/src/index.ts"],
      "@recruit/module-contact": ["./packages/modules/recruit-contact/src/index.ts"],
      "@recruit/module-client": ["./packages/modules/recruit-client/src/index.ts"],
      "@recruit/module-jobs": ["./packages/modules/recruit-jobs/src/index.ts"],
      "@recruit/module-candidate": ["./packages/modules/recruit-candidate/src/index.ts"],
      "@recruit/configurations": ["./packages/configurations/src/index.ts"]
    }
  }
}
