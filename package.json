{
  "name": "ai-recruiter",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run free-ports && turbo run dev --filter=!@recruit/desktop",
    "free-ports": "lsof -ti:3000,3001,3002,3003,3004 | xargs kill -9 2>/dev/null || true",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun run --filter=@recruit/api db:generate",
    "db:migrate": "bun run --filter=@recruit/api db:migrate",
    "db:push": "bun run --filter=@recruit/api db:push",
    "db:studio": "bun run --filter=@recruit/api db:studio",
    "desktop": "turbo run dev --filter=@recruit/desktop",
    "desktop:build": "turbo run build --filter=@recruit/desktop",
    "test": "bun test apps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.10.0",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.1.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "apexcharts": "^5",
    "axios": "^1.18.1",
    "better-auth": "^1.2.8",
    "dlv": "^1.1.3",
    "drizzle-orm": "^0.44.2",
    "elysia": "^1.4.29",
    "i18next": "^26.3.6",
    "libphonenumber-js": "^1.13.9",
    "next": "^16.2.10",
    "node-mailjet": "^6.0.11",
    "postgres": "^3.4.5",
    "react": "^19.2.7",
    "react-apexcharts": "^1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.9",
    "sharp": "^0.35.3",
    "swr": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tauri-apps/cli": "^2",
    "@types/dlv": "^1.1.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.1",
    "turbo": "^2.10.4",
    "typescript": "7",
    "vite": "^6.0.0"
  }
}
