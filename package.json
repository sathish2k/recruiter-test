{
  "name": "ai-recruiter",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run free-ports && turbo run dev",
    "free-ports": "lsof -ti:3000,3001,3002,3003,3004 | xargs kill -9 2>/dev/null || true",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun test apps packages",
    "check:autocomplete": "bun scripts/check-autocomplete-slots.mjs",
    "check:icons": "bun scripts/check-icon-names.mjs",
    "check:routes": "bun scripts/check-route-ids.mjs",
    "check:sx-background": "bun scripts/check-sx-background.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.16.0",
    "@hookform/resolvers": "^5.7.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/x-date-pickers": "^9.11.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "apexcharts": "^6.7.0",
    "axios": "^1.19.0",
    "better-auth": "^1.6.26",
    "date-fns": "^4.4.0",
    "dlv": "^1.1.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "i18next": "^26.3.6",
    "libphonenumber-js": "^1.13.10",
    "mammoth": "^1.12.0",
    "next": "^16.3.0",
    "node-mailjet": "^6.0.11",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "sharp": "^0.35.3",
    "swr": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dlv": "^1.1.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
