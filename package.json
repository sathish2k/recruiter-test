{
  "name": "ai-recruiter",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run free-ports && turbo run dev",
    "free-ports": "lsof -ti:3000,3001,3002 | xargs kill -9 2>/dev/null || true",
    "build": "turbo run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "bun test packages apps"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.10.0",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.1.1",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "apexcharts": "^5",
    "axios": "^1.18.1",
    "dlv": "^1.1.3",
    "elysia": "^1.4.29",
    "i18next": "^26.3.6",
    "mongoose": "^9.7.4",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "node-mailjet": "^6.0.11",
    "react": "^19.2.7",
    "react-apexcharts": "^1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.9",
    "swr": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/dlv": "^1.1.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "turbo": "^2.10.4",
    "typescript": "7"
  }
}
