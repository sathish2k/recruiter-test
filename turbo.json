{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Test-harness variables only — they steer where the suites point, never what
  // a build produces, so they pass through without joining the cache key.
  "globalPassThroughEnv": ["E2E_*"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src-tauri/target/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
